{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "rootDir": "./src"
  },
  "include": ["src"],
  "exclude": [
    "node_modules",
    "test",
    "dist",
    "**/*spec.ts",
    "typeorm.config.ts",
    "migrations",
    "logs",
    "uploadfiles",
    "scripts"
  ]
}
