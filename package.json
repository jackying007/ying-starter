{
  "name": "ying",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "dev:apps": "turbo run dev --filter=./apps/*",
    "build:apps": "turbo run build --filter=\"./apps/*\"",
    "build:pkgs": "turbo run build --filter=\"./packages/*\"",
    "compile:server": "turbo run compile --filter=@ying/server",
    "lint": "turbo run lint",
    "check": "turbo run check",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "proxy": "ying-tunnel lhp",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.6.2",
    "@ying-tunnel/cli": "1.4.3",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "oxlint": "1.80.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "turbo": "2.11.7",
    "typescript": "6.0.3"
  }
}
